# Student data — NEVER commit (IRB-covered, DSC 10). See CLAUDE.md rule 4.
data/

# Env / secrets (template with key names only is allowed)
.env
.env.local
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Notebooks: checkpoints always; outputs may quote student text — strip before commit
.ipynb_checkpoints/

# SQLite (should never exist here — this repo never opens a DB — but ignore defensively)
*.db
*.db-shm
*.db-wal
*.db-journal

# OS / tooling
.DS_Store
.claude/
.agents/
.superpowers/
