          "default": null,
          "title": "Assignment Id"
        },
        "outcome": {
          "$ref": "#/$defs/Metric"
        },
        "active_time": {
          "$ref": "#/$defs/Metric"
        },
        "post_help_active_time": {
          "$ref": "#/$defs/Metric"
        },
        "elapsed_time": {
          "$ref": "#/$defs/Metric"
        },
        "reference_active_time": {
          "$ref": "#/$defs/ReferenceTime"
        },
        "failed_checks_after_help": {
          "$ref": "#/$defs/Metric"
        },
        "tutor_requests": {
          "$ref": "#/$defs/Metric"
        },
        "completed_tutor_responses": {
          "$ref": "#/$defs/Metric"
        },
        "repeated_failures": {
          "$ref": "#/$defs/Metric"
        },
        "continued_after_help": {
          "$ref": "#/$defs/Metric"
        },
        "resumed_after_help": {
          "$ref": "#/$defs/Metric"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "title": "Timeline",
          "type": "array"
        },
        "source_event_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Refs",
          "type": "array"
        },
        "quality_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Quality Warnings",
          "type": "array"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        },
        "fusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombinedPriority"
