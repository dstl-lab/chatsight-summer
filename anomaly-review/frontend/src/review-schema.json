      },
      "required": [
        "id",
        "review_rank",
        "flagged",
        "priority_basis",
        "scenario",
        "synthetic",
        "scope",
        "student_id",
        "outcome",
        "active_time",
        "post_help_active_time",
        "elapsed_time",
        "reference_active_time",
        "failed_checks_after_help",
        "tutor_requests",
        "completed_tutor_responses",
        "repeated_failures",
        "continued_after_help",
        "resumed_after_help",
        "timeline",
        "source_event_refs",
        "quality_warnings",
        "analysis"
