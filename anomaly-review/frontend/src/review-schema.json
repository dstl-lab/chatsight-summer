        "source_pointers": {
          "items": {
            "type": "string"
          },
          "title": "Source Pointers",
          "type": "array"
        },
        "supporting_refs": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Refs",
          "type": "array"
        },
        "code_diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeDiff"
