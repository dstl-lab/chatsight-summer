  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": 2,
      "enum": [
        2,
        3
      ],
      "title": "Contract Version",
      "type": "integer"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetInfo"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/ReviewSession"
      },
      "title": "Sessions",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "summary",
    "sessions"
  ],
  "title": "ReviewBundle",
  "type": "object"
}
