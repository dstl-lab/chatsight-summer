      "required": [
        "status",
        "basis"
      ],
      "title": "ReferenceTime",
      "type": "object"
    },
    "ReviewSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "review_rank": {
          "title": "Review Rank",
          "type": "integer"
        },
        "flagged": {
          "title": "Flagged",
          "type": "boolean"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low",
                "none",
                "insufficient_data",
                "routine"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "priority_basis": {
          "title": "Priority Basis",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
