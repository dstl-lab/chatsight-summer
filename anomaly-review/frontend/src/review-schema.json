    "Summary": {
      "additionalProperties": false,
      "properties": {
        "total_sessions": {
          "title": "Total Sessions",
          "type": "integer"
        },
        "flagged_sessions": {
          "title": "Flagged Sessions",
          "type": "integer"
        },
        "high_priority_sessions": {
          "title": "High Priority Sessions",
          "type": "integer"
        },
        "medium_priority_sessions": {
          "default": 0,
          "title": "Medium Priority Sessions",
          "type": "integer"
        },
        "low_priority_sessions": {
          "default": 0,
          "title": "Low Priority Sessions",
          "type": "integer"
        },
        "no_priority_sessions": {
          "default": 0,
          "title": "No Priority Sessions",
          "type": "integer"
        },
        "insufficient_data_sessions": {
          "default": 0,
          "title": "Insufficient Data Sessions",
          "type": "integer"
        }
      },
      "required": [
        "total_sessions",
        "flagged_sessions",
        "high_priority_sessions"
      ],
