{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_analyzed",
            "completed",
            "failed",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "surface",
                "no_supported_finding",
                "insufficient_evidence"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "title": "Validation Errors",
          "type": "array"
        },
        "notices": {
          "items": {
            "type": "string"
          },
          "title": "Notices",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "semantic_interpretations_verified": {
          "const": false,
          "default": false,
          "title": "Semantic Interpretations Verified",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "decision",
        "summary",
        "source"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "CodeDiff": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        }
      },
      "title": "CodeDiff",
      "type": "object"
    },
    "CombinedPriority": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "scored",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low",
            "none",
            "insufficient_data"
          ],
          "title": "Priority",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "metric_signal": {
          "$ref": "#/$defs/MetricSignal"
        },
        "llm_signal": {
          "$ref": "#/$defs/LlmSignal"
        },
        "shared_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Shared Evidence Refs",
          "type": "array"
        },
        "shared_source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Shared Source Event Ids",
          "type": "array"
        },
        "config": {
          "$ref": "#/$defs/FusionConfigView"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "status",
        "priority",
        "rule",
        "summary",
        "metric_signal",
        "llm_signal",
        "config",
        "interpretation"
      ],
      "title": "CombinedPriority",
      "type": "object"
    },
    "DatasetInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "notice": {
          "title": "Notice",
          "type": "string"
        },
        "priority_method": {
          "title": "Priority Method",
          "type": "string"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "analysis_version": {
          "title": "Analysis Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "synthetic",
        "label",
        "notice",
        "priority_method",
        "input_sha256",
        "prompt_sha256",
        "analysis_version"
      ],
      "title": "DatasetInfo",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "before",
            "check_result",
            "revision_executed",
            "execution_checked"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "related_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Id"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "kind",
        "record_id"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "persistent_difficulty",
            "request_mismatch",
            "advice_linked_obstacle"
          ],
          "title": "Category",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "interpretations": {
          "items": {
            "$ref": "#/$defs/Interpretation"
          },
          "minItems": 1,
          "title": "Interpretations",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        },
        "highlight_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Highlight Ids",
          "type": "array"
        },
        "recovery_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recovery Evidence Ids",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "category",
        "explanation",
        "interpretations",
        "highlight_ids",
        "uncertainties"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FusionConfigView": {
      "additionalProperties": false,
      "properties": {
        "strong_composite_score": {
          "title": "Strong Composite Score",
          "type": "number"
        },
        "strong_single_tail_score": {
          "title": "Strong Single Tail Score",
          "type": "number"
        },
        "strong_contribution_count": {
          "title": "Strong Contribution Count",
          "type": "integer"
        }
      },
      "required": [
        "strong_composite_score",
        "strong_single_tail_score",
        "strong_contribution_count"
      ],
      "title": "FusionConfigView",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "LlmSignal": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported_finding",
            "no_supported_finding",
            "insufficient_evidence",
            "not_analyzed"
          ],
          "title": "Status",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "finding_categories": {
          "items": {
            "type": "string"
          },
          "title": "Finding Categories",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "data_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Data Limitations",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "LlmSignal",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "status",
        "value"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricSignal": {
      "additionalProperties": false,
      "properties": {
